{
  // YouSayWhat security rules.
  //
  // TWO SEMANTICS TO KNOW BEFORE EDITING THIS FILE:
  //
  // 1. READ grants cascade DOWNWARD and a child CANNOT revoke a parent's grant.
  //    So you cannot make one field private inside a readable node - a nested
  //    '".read": false' is inert. To hide something, put it in a separate
  //    top-level node (see sessionAuth below).
  // 2. WRITE is allowed if the rule at the path OR ANY ANCESTOR is true.
  //    An ancestor grant therefore overrides anything stricter on a child.
  //
  // Rules are deployed from THIS FILE by CI on every push to main
  // (.github/workflows/deploy.yml runs `firebase deploy --only database`).
  // Never hand-edit rules in the Firebase console - the next push deletes
  // them. That is how the feedbackSessions rules were lost once already.
  "rules": {
    "feedbackSessions": {
      "$code": {
        ".read": true,
        ".write": "!data.exists()",
        "entries": {
          "$entryId": {
            ".write": "!data.exists() && newData.child('text').val().length >= 1 && newData.child('text').val().length <= 2000",
            ".validate": "newData.hasChildren(['text', 'timestamp'])"
          }
        }
      }
    },

    // Host password material. Deliberately a SIBLING of sessions/ rather than a
    // child: sessions/$code has ".read": "auth != null", and because read grants
    // cascade, anything stored inside it would be readable by every signed-in
    // client. Nothing here is readable by anyone.
    "sessionAuth": {
      "$code": {
        ".read": false,
        "passwordHash": {
          ".write": "auth != null && (!data.exists() || root.child('sessions').child($code).child('hostUid').val() === auth.uid)",
          ".validate": "newData.isString() && newData.val().length === 64"
        },
        // Password check by WRITE, not by read. No client can read passwordHash;
        // this rule compares the submitted value against it, so a successful
        // write IS the authentication and nothing readable ever leaks. The
        // sessions/$code write rule then honours any uid holding a claim, which
        // is what lets a host take over from a new device.
        "claims": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && newData.val() === root.child('sessionAuth').child($code).child('passwordHash').val()",
            ".validate": "newData.isString() && newData.val().length === 64"
          }
        }
      }
    },

    "sessions": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || auth.uid === data.child('hostUid').val() || root.child('sessionAuth').child($code).child('claims').child(auth.uid).exists())",

        "players": {
          "$uid": {
            // DELETION ONLY, so a player can leave. A value write makes newData
            // exist at $uid, making this false and falling through to the
            // host-only ancestor - so this does not let a player forge
            // totalScore or gamesPlayed, which have no player grant at all.
            ".write": "auth != null && auth.uid === $uid && !newData.exists()",
            "name": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 30"
            },
            "joinedAt": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "newData.isNumber()"
            },
            "teamCode": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 8)"
            }
          }
        },

        "teams": {
          "$teamCode": {
            ".write": "auth != null && !data.exists()",
            ".validate": "newData.hasChildren(['name', 'captainUid'])",
            "name":       { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 30" },
            "captainUid": { ".validate": "newData.val() === auth.uid" },
            "members": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid",
                ".validate": "!newData.exists() || newData.val() === true"
              }
            }
          }
        }
      }
    },

    "globalLeaderboard": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && (!data.exists() || newData.child('totalScore').val() >= data.child('totalScore').val())",
        "name":        { ".validate": "newData.isString() && newData.val().length <= 30" },
        "totalScore":  { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "gamesPlayed": { ".validate": "newData.isNumber() && newData.val() >= 0" }
      }
    },

    // PLAYERS CANNOT READ THIS NODE - ".read" below is host-only, because the
    // full node contains questions[].correct. Every field a player needs
    // therefore requires its OWN '".read": true' entry (status, currentQuestion,
    // reveal, players, chatEnabled, teamMode, kind, results, chat, reactions,
    // teams, and answers conditionally).
    //
    // Forgetting one FAILS SILENTLY: the client's listener is denied and it
    // keeps its default value. A missing "kind" rule made activities show
    // players the quiz end screen; a missing read made word cloud never render.
    // If you add a player-visible field, add its read rule here in the same
    // commit.
    "games": {
      "$pin": {
        ".read": "auth != null && auth.uid === data.child('hostUid').val()",
        ".write": "auth != null && (!data.exists() || auth.uid === data.child('hostUid').val())",

        "hostUid":       { ".read": true },
        "status":        { ".read": true },
        "currentQuestion": { ".read": true },
        "reveal":        { ".read": true },

        // NOTE: this ".read": false is INERT - read grants cascade and a child
        // cannot revoke the parent's. hostSecret is protected only because
        // games/$pin itself is host-only. SessionHost.resumeGame() reads it on
        // purpose, to re-enter a running game after losing the host tab.
        "hostSecret": {
          ".read": false
        },

        "questions": {
          ".read": "auth != null && auth.uid === data.parent().child('hostUid').val()"
        },

        "players": {
          ".read": true,
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },

        // Readable by everyone at reveal, and while a poll or word cloud question
        // is live - neither has a correct answer to leak, and watching results
        // build is the point of them. Never readable during an MCQ question.
        "answers": {
          ".read": "auth != null && (auth.uid === data.parent().child('hostUid').val() || data.parent().child('status').val() === 'reveal' || data.parent().child('currentQuestion').child('type').val() === 'poll' || data.parent().child('currentQuestion').child('type').val() === 'wordcloud')",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && data.parent().parent().child('status').val() === 'question'"
          }
        },

        "tamperLog": {
          ".read": "auth != null && auth.uid === data.parent().child('hostUid').val()",
          "$id": {
            ".write": "auth != null && auth.uid !== data.parent().parent().child('hostUid').val()"
          }
        },

        "chatEnabled": {
          ".read": true
        },

        "teamMode": {
          ".read": true
        },

        "kind": {
          ".read": true
        },

        "reactions": {
          ".read": true,
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },

        "teams": {
          ".read": true,
          "$teamCode": {
            ".write": "auth != null && (
              !data.exists() ||
              data.child('captainUid').val() === auth.uid ||
              newData.child('members').child(auth.uid).val() === true
            )"
          }
        },

        "results": {
          ".read": true
        },

        "chat": {
          ".read": true,
          "$msgId": {
            ".write": "auth != null
              && newData.child('uid').val() === auth.uid
              && newData.child('text').val().length >= 1
              && newData.child('text').val().length <= 200
              && (
                !root.child('games').child($pin).child('players').child(auth.uid).child('lastMessageAt').exists()
                || now - root.child('games').child($pin).child('players').child(auth.uid).child('lastMessageAt').val() > 3000
              )"
          }
        }
      }
    }
  }
}
